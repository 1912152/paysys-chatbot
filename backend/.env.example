# AI Models
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_PROVIDER=groq  # groq or openai
AI_MODEL=llama-3.3-70b-versatile  # or gpt-4o-mini

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/paysys_chatbot

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# Auth
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Notifications
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
AGENT_WHATSAPP_NUMBER=whatsapp:+923001234567

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
AGENT_EMAIL=sales@paysyslabs.com

# App
APP_NAME=Paysys Chatbot
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000","https://paysyslabs.com"]
